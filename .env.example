# Rovlo build-time configuration — copy to `.env` and fill in.
# NEVER commit `.env`.
#
#   flutter run --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env
#   flutter build appbundle --release --dart-define-from-file=.env
#
# See Rovlo-Backend/SUPABASE_SETUP.md for how to get every value.

# ── Supabase (REQUIRED) ── Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# ── Google Sign-In (REQUIRED) ── OAuth client of type "Web application"
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# ── Map (OPTIONAL) ── free key from maptiler.com; leave empty to use OpenStreetMap
MAPTILER_KEY=

# ── Firebase (only for push notifications) ──
FIREBASE_API_KEY=YOUR_API_KEY_HERE
FIREBASE_ANDROID_APP_ID=1:SENDER_ID:android:HASH
FIREBASE_IOS_APP_ID=1:SENDER_ID:ios:HASH
FIREBASE_WEB_APP_ID=1:SENDER_ID:web:HASH
FIREBASE_WINDOWS_APP_ID=1:SENDER_ID:web:HASH
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
